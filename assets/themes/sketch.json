{
  "format": "orion-theme",
  "version": 1,
  "id": "sketch",
  "name": "Sketch",
  "author": "ORION",
  "family": "Hand-drawn paper · after PaperCSS",
  "description": "Crooked pen lines, tinted fills and soft shadows: a UI on a notepad",
  "page": {
    "background": "paper",
    "colors": ["#fffdf7", "#f6f1e4", "#ffffff", "#000000"],
    "params": [0, 0, 0, 0],
    "color": "#fbf8ef",
    "text": "#00000000",
    "text_muted": "#00000000"
  },
  "palette": {
    "surface": "#ffffff",
    "surface_high": "#fffdf7",
    "text": "#41403e",
    "text_muted": "#8a8782",
    "primary": "#deefff",
    "on_primary": "#0071de",
    "secondary": "#ffffff",
    "on_secondary": "#41403e",
    "accent": "#86a361",
    "outline": "#41403e",
    "focus": "#0071de",
    "shadow": "#00000033",
    "light": "#ffffff",
    "danger": "#e5484d",
    "success": "#30a46c",
    "warning": "#f5a524"
  },
  "shape": {
    "style": "sketch",
    "corner": "round",
    "radius": 4,
    "radius_card": 4,
    "border": 3,
    "button_border": -1,
    "pill_chips": false,
    "pill_switches": false,
    "shadow_offset": 12,
    "shadow_blur": 16,
    "focus_width": 3,
    "focus_gap": 4,
    "underline_fields": false
  },
  "type": {
    "heading": "hand",
    "label": "hand",
    "caps": false,
    "tracking": 0
  },
  "motion": {
    "omega": 14,
    "damping": 0.55,
    "sounds": "paper"
  },
  "dark": false,
  "orion": {
    "clouds": 100,
    "motion": true,
    "cover_corners": 22
  }
}
