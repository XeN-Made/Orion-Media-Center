{
  "format": "orion-theme",
  "version": 1,
  "id": "paper",
  "name": "Material",
  "author": "ORION",
  "family": "Material Design · after Propeller",
  "description": "Raised sheets with real shadows, capitals, underlined fields, a pink accent",
  "page": {
    "background": "gradient",
    "colors": ["#eeeeee", "#eeeeee", "#000000", "#000000"],
    "params": [0, 0, 0, 0],
    "color": "#eeeeee",
    "text": "#00000000",
    "text_muted": "#00000000"
  },
  "palette": {
    "surface": "#ffffff",
    "surface_high": "#dcdcdc",
    "text": "#212121",
    "text_muted": "#757575",
    "primary": "#4285f4",
    "on_primary": "#ffffff",
    "secondary": "#ffffff",
    "on_secondary": "#212121",
    "accent": "#ff4081",
    "outline": "#00000000",
    "focus": "#4285f480",
    "shadow": "#0000004d",
    "light": "#ffffff",
    "danger": "#e5484d",
    "success": "#30a46c",
    "warning": "#f5a524"
  },
  "shape": {
    "style": "soft",
    "corner": "round",
    "radius": 3,
    "radius_card": 4,
    "border": 0,
    "button_border": -1,
    "pill_chips": false,
    "pill_switches": true,
    "shadow_offset": 4,
    "shadow_blur": 9,
    "focus_width": 5,
    "focus_gap": 0,
    "underline_fields": true
  },
  "type": {
    "heading": "semibold",
    "label": "semibold",
    "caps": true,
    "tracking": 1
  },
  "motion": {
    "omega": 18,
    "damping": 1,
    "sounds": "glass"
  },
  "dark": false,
  "orion": {
    "clouds": 100,
    "motion": true,
    "cover_corners": 22
  }
}
