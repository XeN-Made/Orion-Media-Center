{
  "format": "orion-theme",
  "version": 1,
  "id": "friendly",
  "name": "Friendly",
  "author": "ORION",
  "family": "Friendly and soft · after Bulma",
  "description": "Turquoise, generous round boxes floating on a long soft shadow",
  "page": {
    "background": "gradient",
    "colors": ["#ffffff", "#ffffff", "#000000", "#000000"],
    "params": [0, 0, 0, 0],
    "color": "#ffffff",
    "text": "#00000000",
    "text_muted": "#00000000"
  },
  "palette": {
    "surface": "#ffffff",
    "surface_high": "#f5f5f5",
    "text": "#363636",
    "text_muted": "#7a7a7a",
    "primary": "#00d1b2",
    "on_primary": "#ffffff",
    "secondary": "#ffffff",
    "on_secondary": "#363636",
    "accent": "#485fc7",
    "outline": "#dbdbdb",
    "focus": "#485fc74d",
    "shadow": "#0a0a0a1f",
    "light": "#ffffff",
    "danger": "#e5484d",
    "success": "#30a46c",
    "warning": "#f5a524"
  },
  "shape": {
    "style": "flat",
    "corner": "round",
    "radius": 10,
    "radius_card": 19,
    "border": 1.5,
    "button_border": -1,
    "pill_chips": true,
    "pill_switches": true,
    "shadow_offset": 12,
    "shadow_blur": 22,
    "focus_width": 5,
    "focus_gap": 0,
    "underline_fields": false
  },
  "type": {
    "heading": "semibold",
    "label": "regular",
    "caps": false,
    "tracking": 0
  },
  "motion": {
    "omega": 18,
    "damping": 1,
    "sounds": "glass"
  },
  "dark": false,
  "orion": {
    "clouds": 100,
    "motion": true,
    "cover_corners": 22
  }
}
