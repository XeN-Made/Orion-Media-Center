{
  "format": "orion-theme",
  "version": 1,
  "id": "soft",
  "name": "Soft",
  "author": "ORION",
  "family": "Modern soft · after Mantine",
  "description": "Blue on white, 8 px corners, tinted \"light\" buttons, no shadows",
  "page": {
    "background": "gradient",
    "colors": ["#ffffff", "#ffffff", "#000000", "#000000"],
    "params": [0, 0, 0, 0],
    "color": "#ffffff",
    "text": "#00000000",
    "text_muted": "#00000000"
  },
  "palette": {
    "surface": "#ffffff",
    "surface_high": "#f1f3f5",
    "text": "#000000",
    "text_muted": "#868e96",
    "primary": "#228be6",
    "on_primary": "#ffffff",
    "secondary": "#e7f5ff",
    "on_secondary": "#1c7ed6",
    "accent": "#228be6",
    "outline": "#dee2e6",
    "focus": "#228be6",
    "shadow": "#00000000",
    "light": "#ffffff",
    "danger": "#e5484d",
    "success": "#30a46c",
    "warning": "#f5a524"
  },
  "shape": {
    "style": "flat",
    "corner": "round",
    "radius": 13,
    "radius_card": 13,
    "border": 1.5,
