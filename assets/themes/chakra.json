{
  "format": "orion-theme",
  "version": 1,
  "id": "chakra",
  "name": "Chakra",
  "author": "ORION",
  "family": "Modern and accessible · after Chakra UI",
  "description": "Teal on white, grey ghost buttons, soft cards, a blue focus halo",
  "page": {
    "background": "gradient",
    "colors": ["#ffffff", "#ffffff", "#000000", "#000000"],
    "params": [0, 0, 0, 0],
    "color": "#ffffff",
    "text": "#00000000",
    "text_muted": "#00000000"
  },
  "palette": {
    "surface": "#ffffff",
    "surface_high": "#edf2f7",
    "text": "#1a202c",
    "text_muted": "#718096",
    "primary": "#319795",
    "on_primary": "#ffffff",
    "secondary": "#edf2f7",
    "on_secondary": "#1a202c",
    "accent": "#319795",
    "outline": "#e2e8f0",
    "focus": "#4299e199",
    "shadow": "#0000001f",
    "light": "#ffffff",
    "danger": "#e5484d",
    "success": "#30a46c",
    "warning": "#f5a524"
  },
  "shape": {
    "style": "flat",
    "corner": "round",
    "radius": 10,
    "radius_card": 13,
    "border": 1.5,
    "button_border": 0,
    "pill_chips": false,
    "pill_switches": true,
    "shadow_offset": 5,
    "shadow_blur": 12,
    "focus_width": 5,
    "focus_gap": 0,
    "underline_fields": false
  },
  "type": {
    "heading": "semibold",
    "label": "semibold",
    "caps": false,
    "tracking": 0
  },
  "motion": {
    "omega": 18,
    "damping": 1,
    "sounds": "glass"
  },
  "dark": false,
  "orion": {
    "clouds": 100,
    "motion": true,
    "cover_corners": 22
  }
}
