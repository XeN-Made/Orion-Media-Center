{
  "format": "orion-theme",
  "version": 1,
  "id": "humane",
  "name": "Humane",
  "author": "ORION",
  "family": "Clean and readable · after Semantic UI",
  "description": "Soft grey buttons with bold labels, white segments, 4 px corners",
  "page": {
    "background": "gradient",
    "colors": ["#f7f8f9", "#f7f8f9", "#000000", "#000000"],
    "params": [0, 0, 0, 0],
    "color": "#f7f8f9",
    "text": "#00000000",
    "text_muted": "#00000000"
  },
  "palette": {
    "surface": "#ffffff",
    "surface_high": "#e9eaeb",
    "text": "#212121",
    "text_muted": "#6b6b6b",
    "primary": "#2185d0",
    "on_primary": "#ffffff",
    "secondary": "#e0e1e2",
    "on_secondary": "#5a5a5a",
    "accent": "#2185d0",
    "outline": "#dededf",
    "focus": "#85b7d9",
    "shadow": "#22242629",
    "light": "#ffffff",
    "danger": "#e5484d",
    "success": "#30a46c",
    "warning": "#f5a524"
  },
  "shape": {
    "style": "flat",
    "corner": "round",
    "radius": 7,
    "radius_card": 7,
    "border": 1.5,
    "button_border": 0,
    "pill_chips": false,
    "pill_switches": true,
    "shadow_offset": 2,
    "shadow_blur": 4,
    "focus_width": 3,
    "focus_gap": 1,
    "underline_fields": false
  },
  "type": {
    "heading": "semibold",
    "label": "semibold",
    "caps": false,
    "tracking": 0
  },
  "motion": {
    "omega": 18,
    "damping": 1,
    "sounds": "glass"
  },
  "dark": false,
  "orion": {
    "clouds": 100,
    "motion": true,
    "cover_corners": 22
  }
}
